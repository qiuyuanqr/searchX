<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  searchX runner 定时任务（仅在常驻不关机的 Mac mini 上加载）。
  安装：cp 本文件到 ~/Library/LaunchAgents/ 后 launchctl bootstrap，详见 ../README.md「定时无人值守」。
  StartInterval=300 即每 5 分钟一跑；改 900=15 分钟、1800=30 分钟、3600=1 小时。
  RunAtLoad=false：加载时不立即跑，避免装好瞬间就触发真实上线+发信；要立刻验证用 launchctl kickstart。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.searchx.runner</string>

  <!--
    Codex 运行配置（2026-10-03 起后台改调 Codex；2026-10-11 补进模板，此前只存在于 Mac mini 已安装的那份里）。
    装上即生效：SEARCHX_CODEX_DELIVERY_ENABLED=1 就是允许真实取队列、发布、通知，所以本模板只用于常驻机。
    SEARCHX_CODEX_BIN 钉的是带版本号的真实目录，不是 ~/.local/bin/codex 软链：这台机器上另有一个旧版 codex，
    模型目录里没有 gpt-6.1-sol；升级 codex 要改这一项并重载两个服务，目录不存在时启动预检会报错、不取队列。
    两个 OBSIDIAN_VAULT 两份模板都带，是照已安装配置原样记录。
    这里只放非敏感项。密钥、口令、登录令牌一律不进模板、不进仓库。
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHECK_RUNNER_OBSIDIAN_VAULT</key>
    <string>/Volumes/SS_SSD/obsidian</string>
    <key>RUNNER_OBSIDIAN_VAULT</key>
    <string>/Volumes/SS_SSD/obsidian</string>
    <key>SEARCHX_CODEX_BIN</key>
    <string>/Users/yangqiuyuan/.local/share/stocks/codex-0.160.0/node_modules/.bin/codex</string>
    <key>SEARCHX_CODEX_DELIVERY_ENABLED</key>
    <string>1</string>
    <key>SEARCHX_CODEX_EFFORT</key>
    <string>high</string>
    <key>SEARCHX_CODEX_MODEL</key>
    <string>gpt-6.1-sol</string>
    <key>SEARCHX_CODEX_STATE_ROOT</key>
    <string>/Users/yangqiuyuan/Library/Application Support/searchx-codex-jobs</string>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yangqiuyuan/Coding/searchX/services/runner/scheduled-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yangqiuyuan/Coding/searchX</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/yangqiuyuan/Library/Logs/searchx-runner/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yangqiuyuan/Library/Logs/searchx-runner/launchd.err.log</string>
</dict>
</plist>

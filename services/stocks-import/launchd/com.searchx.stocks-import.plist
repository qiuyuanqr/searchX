<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Stocks → searchX 每日同步（仅在常驻不关机、且装着 Stocks 活库的 Mac mini 上加载）。
  安装：cp 本文件到 ~/Library/LaunchAgents/ 后 launchctl bootstrap，详见 ../README.md。

  StartInterval=300 即每 5 分钟看一眼库里有没有新报告；改 900=15 分钟、1800=30 分钟。

  为什么敢这么频繁（2026-08-17 改，原先是每天 09:30 一次）：**这条通路整个不出网**——
  它读的是同一台机器上的 SQLite 文件，不碰 Cloudflare、不碰 KV、不调 GitHub API，
  因此与「KV list 日额度被轮询打爆」那类故障（见 services/intake-worker）没有任何关系。
  空跑实测 0.14 秒，一天 288 次合计约 40 秒 CPU；这台机器上 Stocks 自己就挂着 40 多个
  定时任务，随便一个 daily-update 都比它重几个数量级。
  真正花钱的 git push 与 CI 部署只在**确有新报告**时才发生，次数等于报告篇数，与轮询频率无关。

  为什么不并进 com.searchx.runner 的那 5 分钟：runner 跑的是全力档 /research，单次可能几十分钟，
  且自带互斥锁——并进去等于让「搬一篇现成报告」去排「从头跑一篇研究」的队，
  本来 2 分钟能上线的东西会被堵到几十分钟后，两件事的故障也会互相牵连。各跑各的更快也更好排障。

  RunAtLoad=false：装载时不立刻跑，避免 launchctl bootstrap 的瞬间就触发一次真实上线+推送。
  机器在触发时刻睡着/关机时 launchd 会在下次唤醒后补跑一次（这正是要的行为）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.searchx.stocks-import</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yangqiuyuan/Coding/searchX/services/stocks-import/scheduled-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yangqiuyuan/Coding/searchX</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/yangqiuyuan/Library/Logs/searchx-stocks-import/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yangqiuyuan/Library/Logs/searchx-stocks-import/launchd.err.log</string>
</dict>
</plist>

{
  "name": "searchx-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run web/build/cli.js && bun x pagefind --site web/dist",
    "test": "bun test",
    "serve": "bun run build && python3 -m http.server 8080 --directory web/dist",
    "build:worker": "bun build services/intake-worker/src/index.js --outfile services/intake-worker/dist/worker.js --format esm",
    "runner": "bun run services/runner/src/index.js",
    "stocks-import": "bun run services/stocks-import/src/index.js",
    "stocks-import:now": "launchctl kickstart gui/$(id -u)/com.searchx.stocks-import",
    "stocks-import:log": "tail -n 80 \"$HOME/Library/Logs/searchx-stocks-import/stocks-import.log\"",
    "runner:now": "launchctl kickstart gui/$(id -u)/com.searchx.runner",
    "runner:log": "tail -n 80 \"$HOME/Library/Logs/searchx-runner/runner.log\"",
    "check-runner": "bun run services/check-runner/src/index.js",
    "check-runner:now": "launchctl kickstart gui/$(id -u)/com.searchx.check-runner",
    "check-runner:log": "tail -n 80 \"$HOME/Library/Logs/searchx-check-runner/check-runner.log\"",
    "check:sources": "bun run scripts/check-sources.js",
    "check:qc": "bun run scripts/research-qc.js",
    "check:web": "bun run scripts/check-web-numbers.js",
    "backfill:sources": "bun run scripts/backfill-sources.js",
    "probe:stats": "bun run scripts/probe-stats.js"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "pagefind": "^1.1.0"
  },
  "dependencies": {
    "nodemailer": "^8.0.10"
  },
  "overrides": {
    "js-yaml": "^3.15.0"
  }
}

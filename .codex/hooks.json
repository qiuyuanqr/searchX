{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/git-sync.sh' pull",
            "timeout": 30,
            "statusMessage": "git 同步：拉取另一台的进度…"
          },
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/memory-sync.sh' pull",
            "timeout": 20,
            "statusMessage": "记忆同步：拉回另一台的新记忆…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/git-sync.sh' push",
            "timeout": 30,
            "statusMessage": "git 同步：提交并推送本次改动…"
          },
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/memory-sync.sh' push",
            "timeout": 20,
            "statusMessage": "记忆同步：把本次记忆推给另一台…"
          }
        ]
      }
    ]
  }
}

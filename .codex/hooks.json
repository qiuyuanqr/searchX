{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/git-sync.sh' pull",
            "timeout": 30,
            "statusMessage": "git 同步：拉取另一台的进度…"
          },
          {
            "type": "command",
            "command": "'/Users/yangqiuyuan/Coding/searchX/.codex/hooks/memory-sync.sh' pull",
            "timeout": 20,
            "statusMessage": "记忆同步：拉回另一台的新记忆…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/yangqiuyuan/Coding/searchX/scripts/session-end-status.py'",
            "timeout": 3,
            "statusMessage": "收尾检查：仅查看本地状态，不提交或同步…"
          }
        ]
      }
    ]
  }
}
